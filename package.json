{
  "name": "adbrain",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://adbrain.vanshul.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vanshulgoyal101/adbrain.git"
  },
  "scripts": {
    "dev": "node --max-old-space-size=1536 ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high && npm audit --audit-level=critical",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "db:push": "node scripts/apply-schema.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "worker:campaigns": "tsx scripts/campaign-worker.ts",
    "test:meta-db": "node scripts/check-meta-connect-db.mjs",
    "seed:demo-clinic": "node scripts/seed-demo-clinic.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "env:doctor": "bash scripts/env-doctor.sh",
    "env:doctor:strict": "bash scripts/env-doctor.sh --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --pool=threads --maxWorkers=2",
    "test:core": "vitest run tests/core",
    "ui-gate": "node scripts/ui-gate.mjs",
    "test:workspace-browser": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test",
    "test:workspace-ux": "node --env-file-if-exists=.env.local scripts/check-workspace-ux.mjs",
    "test:scroll-layout": "node scripts/check-scroll-layout.mjs",
    "eval:creative": "node scripts/eval-creative.mjs",
    "eval:create": "tsx --env-file=.env.local scripts/eval-create.ts",
    "smoke:core": "node scripts/smoke-core.mjs",
    "stats": "node scripts/stats.mjs",
    "perf:pages": "node scripts/perf-pages.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.104",
    "@ai-sdk/openai-compatible": "3.0.77",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "5.104.5",
    "ai": "7.0.152",
    "clsx": "^2.1.1",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "node-html-parser": "^9.0.5",
    "razorpay": "2.9.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "github-slugger": "2.0.0",
    "jsdom": "^30.1.3",
    "markdown-it": "15.0.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
