# ─────────────────────────────────────────────────────────────
# AdBrain environment variables
# Copy this file to `.env.local` and fill in the values.
# Never commit real secrets. `.env.local` is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
# Project URL and keys from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── LLM providers (copy generation + website→brand extraction) ─
# The LLM layer ROTATES across providers and across multiple keys
# per provider. Add as many comma-separated keys as you have; the
# orchestrator round-robins them and skips ones that are rate-limited.
# Leave a provider blank to disable it. All are free-tier friendly.
#
# Google AI Studio (Gemini):  https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEYS=
# Groq (fast Llama):          https://console.groq.com/keys
GROQ_API_KEYS=
# OpenRouter (free models):   https://openrouter.ai/keys
OPENROUTER_API_KEYS=
# Cerebras:                   https://cloud.cerebras.ai/
CEREBRAS_API_KEYS=
# Order to try providers in (comma-separated names).
LLM_PROVIDER_ORDER=google,groq,openrouter,cerebras
# Gemini model to use (must have quota on your key's project).
GEMINI_MODEL=gemini-2.0-flash
# Groq model. Groq retires models with little notice — check
# https://api.groq.com/openai/v1/models if generation starts returning 404.
GROQ_MODEL=qwen/qwen3.8-27b
# Extra output-token budget for Gemini 2.5 "thinking" models so JSON isn't
# truncated. Set to 0 for a paid non-thinking model to avoid paying for it.
GEMINI_THINKING_HEADROOM=3000

# ── Image generation ─────────────────────────────────────────
# Default provider is `pollinations` (free, no key required).
# Swap to `falai` or `openai` later by setting IMAGE_PROVIDER + key.
IMAGE_PROVIDER=pollinations
POLLINATIONS_MODEL=flux
FALAI_API_KEY=
OPENAI_API_KEY=
# Composite the designed poster (logo + headline + benefits + CTA) over the AI
# photo. Set to `false` to serve the bare photo instead.
AD_DESIGN_OVERLAY=true

# ── Meta Marketing API ────────────────────────────────────────
# APP_ID/SECRET power both server ops and the "Connect with Facebook" flow
# (Settings). Owners connect their own ad account via OAuth; the SYSTEM_USER /
# AD_ACCOUNT / PAGE vars below are the single-tenant fallback (e.g. Solaride).
# Whitelist <site>/api/meta/oauth/callback in the Meta app's OAuth redirect URIs.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# ── Internal traffic runner (optional, for Meta review prep) ──
# Comma-separated allowlist of emails that can trigger /api/internal/meta-traffic.
# Leave empty to disable the endpoint in production (it 404s); in development an
# empty list allows any signed-in user.
TRAFFIC_GENERATOR_ALLOWED_EMAILS=
# Hard cap for requested rounds per run.
TRAFFIC_GENERATOR_MAX_ROUNDS=20

# ── Demo seed (scripts/seed-demo-clinic.mjs) ─────────────────
# Owns the Cedar Ridge Chiropractic demo clinic. Must be its OWN user — AdBrain
# is single-business-per-user, so an account's oldest business always wins.
# Generate the password with: openssl rand -base64 24
DEMO_USER_EMAIL=demo@adbrain.vanshul.com
DEMO_USER_PASSWORD=

# ── Scheduled jobs (Vercel Cron) ────────────────────────────
# Vercel sends this as `Authorization: Bearer <secret>` to /api/cron/*.
# REQUIRED in production: the daily keep-alive stops the free-tier Supabase
# project auto-pausing (a paused project stops resolving in DNS — auth and all
# queries go down). Leave empty locally to disable the cron endpoints.
CRON_SECRET=

# ── Script-only runtime vars (optional; keep in .env.local only) ──
# Used by scripts/daily-adbrain-test.sh and scripts/generate-meta-traffic.sh.
ADBRAIN_REVIEWER_EMAIL=
ADBRAIN_REVIEWER_PASSWORD=
# These usually match NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Validate your setup quickly:
# npm run env:doctor
# npm run env:doctor:strict
